# MultiOrganAI Environment Configuration Example
# Copy this file to .env and adjust variables as needed

# Database connection URL (Default: SQLite database located in database/organ_app.db)
DATABASE_URL=sqlite:///database/organ_app.db

# Flask and JWT Security Secrets
SECRET_KEY=multiorganai-dev-secret-key-2026-secure
JWT_SECRET=multiorganai-jwt-secret-key-2026-secure

# Server Port
PORT=5000
